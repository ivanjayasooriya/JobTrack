# GEMINI_API_KEY: Optional - used for post-MVP AI resume analysis features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Connection Variables (injected at runtime by AI Studio Cloud SQL)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"
